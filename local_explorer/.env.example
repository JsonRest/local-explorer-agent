# Copy this file to local_explorer/.env and fill in your values.
# Never commit local_explorer/.env to version control.
#
# After filling in values, run:
#   uv sync
#   uv run adk web

# ── Vertex AI / Gemini ────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True

# Model to use (new projects: gemini-2.5-flash  |  older: gemini-2.0-flash)
MODEL=gemini-2.5-flash

# ── Google Maps Grounding Lite ────────────────────────────────────────────────
# 1. Enable the API:
#      gcloud services enable mapstools.googleapis.com
#      gcloud beta services mcp enable mapstools.googleapis.com
# 2. Grant IAM role:
#      gcloud projects add-iam-policy-binding YOUR_PROJECT_ID \
#        --member="user:YOUR_EMAIL" --role="roles/mcp.toolUser"
# 3. Create an API key:
#      gcloud alpha services api-keys create \
#        --display-name="Local Explorer Maps Key" \
#        --api-target=service=mapstools.googleapis.com
MAPS_API_KEY=your-maps-api-key
